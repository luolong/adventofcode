package day02

import "core:math"

POW10_UINT: [20]uint = {
    1, // 10^0
    10, // 10^1
    100, // 10^2
    1000, // 10^3
    10000, // 10^4
    100000, // 10^5
    1000000, // 10^6
    10000000, // 10^7
    100000000, // 10^8
    1000000000, // 10^9
    10000000000, // 10^10
    100000000000, // 10^11
    1000000000000, // 10^12
    10000000000000, // 10^13
    100000000000000, // 10^14
    1000000000000000, // 10^15
    10000000000000000, // 10^16
    100000000000000000, // 10^17
    1000000000000000000, // 10^18
    10000000000000000000, // 10^19 (Max possible u64 value fits inside 18_446_744_073_709_551_615)
}

num_digits :: proc(n: uint) -> uint {
    return uint(math.log10(f64(n)) + 1)
}

geometric_sum :: proc(m, k: uint) -> uint {
    sum: uint = 0
    for i in 0 ..< m {
        sum += pow10(i * k)
    }
    return sum
}

pow10 :: proc(n: uint) -> uint {
    return POW10_UINT[n]
}
